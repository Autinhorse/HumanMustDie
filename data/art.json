{
  "_comment": "美术参数。风格参考 ref/Arrow 05.jpg（Isle of Arrows）。tools/blender/build_island.py 里的 STYLE 用的是同一套值，两边要一起改。",

  "palette": {
    "_comment": "地面顶面三档色差，避免大片死白；侧面统一灰岩",
    "floor_top":   ["#DED6C4", "#D6CDB9", "#C6BCA7"],
    "floor_top_weights": [0.78, 0.15, 0.07],
    "floor_side":  "#8D8477",
    "bridge_top":  "#C6AC80",
    "bridge_side": "#8D8477",
    "wall_top":    "#F2EFE6",
    "wall_side":   "#A79D8A",
    "obstacle_top":  "#8A8079",
    "obstacle_side": "#6E645D",
    "rock_top":    "#8C7E72",
    "rock_deep":   "#6B5C52",
    "core_rim":    "#EDE7DA",
    "grid_line":   "#BDB3A0",
    "core_water":  "#3FB3B0",
    "entrance":    "#D4825F",
    "cloud":       "#E4EFEE",
    "cloud_top":   "#FFFFFF",
    "cloud_bottom": "#B9CFD1"
  },

  "rock": {
    "_comment": "岛底岩柱：程序化生成，跟着地图走。同种子同地图=同一座岛",
    "seed": 20260911,
    "solid_depth": 2.6,
    "edge_depth_min": 1.0,
    "edge_depth_max": 3.6,
    "edge_long_chance": 0.55,
    "inner_depth_min": 0.4,
    "inner_depth_max": 1.2,
    "taper": 0.72,
    "taper_variance": 0.22,
    "jitter": 0.26,
    "skip_chance": 0.22,
    "top_scale_min": 0.62
  },

  "clouds": {
    "_comment": "背景柔边薄雾。alpha 越低越接近天空；softness 越小边缘越虚；width 是相对画面高度的比例",
    "enabled": true,
    "count": 11,
    "alpha": 0.55,
    "softness": 0.42,
    "width_min": 0.55,
    "width_max": 1.45,
    "aspect_min": 2.4,
    "aspect_max": 4.5
  },

  "anim": {
    "_comment": "跑步动作与配色。shade_darken 是腿/护手相对主色暗多少。相位由走过的距离驱动，所以 stride_ratio 越大步子越大、一个循环耗时越久；其余是各部件的摆动/前倾角度。",
    "leg_swing_deg": 57.0,
    "arm_swing_deg": 60.0,
    "sword_arm_ratio": 0.55,
    "torso_lean_deg": 14.0,
    "head_lean_deg": 4.0,
    "bob_height": 0.06,
    "stride_ratio": 0.715,
    "shade_darken": 0.42,

    "per_model": {
      "_comment": "按模型覆盖上面的动作参数。lock_arms 里的手臂保持模型自带的静止姿势，不参与摆动。",
      "shieldman": {
        "torso_lean_deg": 7.0,
        "head_lean_deg": 2.0,
        "lock_arms": ["ArmL"]
      }
    }
  },

  "zoom_readability": {
    "_comment": "拉远时敌人会变成几个像素，这里按正交可视高度自动补偿：单位放大 + 地面标记淡入。base_ortho 是不做补偿的基准高度。",
    "enabled": true,
    "base_ortho": 26.0,
    "unit_scale_max": 1.7,
    "unit_scale_ortho": 70.0,
    "marker_start": 30.0,
    "marker_full": 60.0,
    "marker_alpha": 0.72,
    "marker_radius_mul": 1.5
  },

  "environment": {
    "sky_top":     "#6B8C91",
    "sky_horizon": "#A6C1C0",
    "ground_horizon": "#8FA9A8",
    "ground_bottom": "#6E8A89",
    "ambient_color": "#A8C2C2",
    "ambient_energy": 0.22,
    "tonemap": "filmic",
    "exposure": 0.85,
    "white": 1.0,

    "fog_enabled": true,
    "fog_color": "#BDD2D0",
    "fog_density": 0.0008,
    "fog_sky_affect": 0.0,
    "fog_aerial_perspective": 0.08,

    "ssao_enabled": true,
    "ssao_radius": 1.0,
    "ssao_intensity": 2.6,
    "ssao_power": 2.0,

    "sun_color": "#FFF6E8",
    "sun_energy": 0.85,
    "sun_elevation_deg": 42.0,
    "sun_azimuth_deg": 35.0,
    "sun_angular_distance_deg": 1.2,
    "shadow_blur": 0.8,
    "fill_color": "#BFD6D6",
    "fill_energy": 0.12,

    "rim_color": "#BCD9EA",
    "rim_energy": 0.55,
    "rim_elevation_deg": 10.0,
    "rim_azimuth_offset_deg": 155.0,

    "glow_enabled": true,
    "glow_intensity": 0.55,
    "glow_bloom": 0.12,
    "glow_hdr_threshold": 1.05,
    "glow_hdr_scale": 2.0,

    "adjust_enabled": true,
    "adjust_brightness": 1.0,
    "adjust_contrast": 1.08,
    "adjust_saturation": 1.12,

    "outline_enabled": false,
    "outline_color": "#4D5560",
    "outline_thickness": 1.2,
    "outline_depth_threshold": 0.08,
    "outline_normal_threshold": 0.22,
    "outline_strength": 0.95,
    "outline_fade_start": 30.0,
    "outline_fade_end": 52.0,
    "outline_depth_fade": 120.0
  },

  "board": {
    "_comment": "地面共面平铺，只用细缝分格；grid_line_width 设 0 就是完全无缝。ao_* 是烘焙进顶点色的环境光遮蔽：ao_corner 管墙角、ao_side 管竖直面底部。",
    "ao_subdiv": 6,
    "ao_radius": 0.55,
    "ao_corner": 0.55,
    "ao_side": 0.32,
    "grid_line_width": 0.07,
    "tile_lift": 0.002,
    "obstacle_height_mul": 1.35,
    "bridge_thickness_mul": 0.6
  }
}
